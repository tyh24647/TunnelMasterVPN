# Load with your process manager; this reference app does not auto-read .env.
DATABASE=/var/lib/tunneldojo/control.sqlite3
PUBLIC_BASE_URL=https://vpn-api.your-domain.example
BUNDLE_ID=com.tyh24647.TunnelDojo
# Keep false until Docs/Release.md is complete.
COMMERCIAL_READY=false
GATEWAY_CATALOG=/etc/tunneldojo/gateways.json
PROVISIONER_URL=https://private-provisioner.your-domain.example
PROVISIONER_TOKEN=REPLACE_WITH_SECRET
# Use one HTTPS OIDC broker with all six configured identity connections.
OIDC_ISSUER=https://identity.your-domain.example/
OIDC_AUTHORIZE_URL=https://identity.your-domain.example/authorize
OIDC_TOKEN_URL=https://identity.your-domain.example/oauth/token
OIDC_USERINFO_URL=https://identity.your-domain.example/userinfo
OIDC_CLIENT_ID=REPLACE
OIDC_CLIENT_SECRET=REPLACE
OIDC_CONNECTIONS_JSON={"apple":"apple","microsoft":"windowslive","discord":"discord","github":"github","facebook":"facebook","google":"google-oauth2"}
SMTP_HOST=smtp.your-domain.example
SMTP_PORT=465
SMTP_USER=REPLACE
SMTP_PASSWORD=REPLACE
MAIL_FROM=TunnelMaster VPN <support@your-domain.example>
APPLE_ENVIRONMENT=Sandbox
APPLE_APP_ID=REPLACE_WITH_NUMERIC_APP_STORE_ID
APPLE_ROOTS_DIRECTORY=/etc/tunneldojo/apple-trust-roots
